{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Rough equivalent of eslint-config-next (core-web-vitals + typescript).
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import"
  ],
  "env": {
    "browser": true,
    "node": true,
    "builtin": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    // Only matters with React Compiler, which this project does not enable.
    "react/incompatible-library": "off",
    // core-web-vitals turns these two into errors.
    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-sync-scripts": "error",
    // Not part of jsx-a11y's recommended set; they flag valid ARIA widgets
    // (role="radio" buttons, table cells) as errors.
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/control-has-associated-label": "off"
  },
  "overrides": [
    {
      // Email clients render plain HTML, so next/link does not apply.
      "files": ["src/components/emails/**"],
      "rules": {
        "nextjs/no-html-link-for-pages": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    "src/generated/**",
    // shadcn components, regenerated by `bunx shadcn@latest add`.
    "src/components/ui/**"
  ]
}
